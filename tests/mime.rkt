#lang racket/base
(require rackunit net/base64 racket/string (prefix-in g: gregor) "../main.rkt")
(define calendar "BEGIN:VCALENDAR\r\nBEGIN:VEVENT\r\nSUMMARY:café\r\nDTSTART:20261118T140000Z\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n")
(define (base64-message value)
  (bytes-append #"MIME-Version: 1.0\r\nContent-Type: text/calendar; charset=UTF-8; method=CANCEL\r\nContent-Disposition: attachment; filename=\"Invite.ICS\"\r\nContent-Transfer-Encoding: base64\r\n\r\n"
                (base64-encode (string->bytes/utf-8 value))))
(define parts (read-calendar-mime (base64-message calendar)))
(check-equal? (length parts) 1)
(check-equal? (ical-part-name (car parts)) "Invite.ICS")
(check-false (ical-part-error (car parts)))
(define e (car (calendar-part-events (car parts))))
(check-equal? (ical-event-title e) "café")
(check-equal? (ical-event-status e) "CANCELLED")
(check-true (g:datetime? (ical-time-value (ical-event-start e))))
(check-equal? (g:~t (ical-time-value (ical-event-start e)) "yyyy-MM-dd HH:mm:ss") "2026-11-18 14:00:00")
(define qp #"Content-Type: text/calendar; charset=iso-8859-1\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\nBEGIN:VCALENDAR\r\nBEGIN:VEVENT\r\nSUMMARY:caf=E9\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n")
(check-equal? (ical-event-title (car (calendar-part-events (car (read-calendar-mime qp))))) "café")
(define multipart
  (bytes-append #"MIME-Version: 1.0\r\nContent-Type: multipart/mixed; boundary=parts\r\n\r\n--parts\r\nContent-Type: text/plain\r\n\r\nBEGIN:VCALENDAR is ordinary quoted mail here.\r\n--parts\r\n"
                (base64-message calendar)
                #"\r\n--parts\r\nContent-Type: text/calendar\r\n\r\nnot a calendar\r\n--parts--\r\n"))
(define multi (read-calendar-mime multipart))
(check-equal? (length multi) 2)
(check-false (ical-part-error (car multi)))
(check-equal? (ical-part-error (cadr multi)) "Could not parse this calendar part.")
(check-equal? (calendar-part-events (cadr multi)) '())
(check-equal? (read-calendar-mime #"Content-Type: text/plain\r\n\r\nNo calendar") '())
(check-exn exn:fail:ical? (lambda () (read-calendar-mime multipart #:max-bytes 8)))
(define conflict (car (read-calendar-mime (base64-message (string-replace calendar "BEGIN:VCALENDAR\r\n" "BEGIN:VCALENDAR\r\nMETHOD:REQUEST\r\n")))))
(check-equal? (ical-event-method (car (calendar-part-events conflict))) "REQUEST")
(check-equal? (length (ical-event-warnings (car (calendar-part-events conflict)))) 1)
(define all-day (car (calendar-events (parse-ics "BEGIN:VCALENDAR\nBEGIN:VEVENT\nDTSTART;VALUE=DATE:20240229\nEND:VEVENT\nEND:VCALENDAR"))))
(check-true (g:date? (ical-time-value (ical-event-start all-day))))
(define port (open-input-bytes (base64-message calendar)))
(void (read-calendar-mime port))
(check-false (port-closed? port))
