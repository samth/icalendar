#lang racket/base
(require rackunit racket/list racket/port racket/string "../main.rkt")
(define (calendar body [method ""]) (parse-ics (string-append "BEGIN:VCALENDAR\r\n" method body "\r\nEND:VCALENDAR\r\n")))
(define (event body [method ""]) (car (calendar-events (calendar (string-append "BEGIN:VEVENT\r\n" body "\r\nEND:VEVENT") method))))
(define invite (event "UID:one\r\nSUMMARY:Meet\\, discuss\\; plan\\nNext\\\\line\r\nDTSTART;TZID=America/New_York:20261118T140000\r\nDTEND;TZID=America/New_York:20261118T150000\r\nORGANIZER;CN=\"A: B; C, D^'s^nName\":mailto:a@example.test\r\nATTENDEE;PARTSTAT=ACCEPTED;RSVP=TRUE:mailto:b@example.test\r\nRRULE:FREQ=WEEKLY;BYDAY=WE\r\nBEGIN:VALARM\r\nDESCRIPTION:Alarm\r\nDTSTART:20000101T000000Z\r\nEND:VALARM" "METHOD:REQUEST\r\n"))
(check-equal? (ical-event-title invite) "Meet, discuss; plan\nNext\\line")
(check-equal? (ical-time-zone (ical-event-start invite)) "America/New_York")
(check-equal? (ical-person-name (ical-event-organizer invite)) "A: B; C, D\"s\nName")
(check-equal? (ical-person-address (ical-event-organizer invite)) "a@example.test")
(check-equal? (ical-person-status (car (ical-event-attendees invite))) "ACCEPTED")
(check-true (ical-person-rsvp? (car (ical-event-attendees invite))))
(check-equal? (ical-event-recurrence invite) "FREQ=WEEKLY;BYDAY=WE")
(check-equal? (ical-time-date (ical-event-start invite)) "2026-11-18")
(check-true (string-contains? (event->text invite) "Organizer:"))
(check-equal? (ical-event-status (event "SUMMARY:Cancelled" "METHOD:CANCEL\r\n")) "CANCELLED")
(check-equal? (ical-event-method (event "ATTENDEE;PARTSTAT=DECLINED:mailto:a@example.test" "METHOD:REPLY\r\n")) "REPLY")
(define all-day (event "DTSTART;VALUE=DATE:20240229\r\nDTEND;VALUE=DATE:20240301"))
(check-true (ical-time-all-day? (ical-event-start all-day)))
(check-true (string-contains? (event->text all-day) "Ends before: 2024-03-01"))
(check-equal? (ical-time-zone (ical-event-start (event "DTSTART:20261117T120000Z"))) "UTC")
(check-true (string-contains? (event->text (event "DTSTART:20261117T120000")) "time zone unspecified"))
(check-false (ical-event-start (event "DTSTART:20230229T120000Z")))
(check-equal? (length (ical-event-warnings (event "DTSTART;TZID=UTC:20261117T120000Z"))) 1)
(check-false (ical-event-start (event "DTSTART:20261117T250000")))
(check-equal? (ical-time-clock (ical-event-start (event "DTSTART:20261117T235960Z"))) "23:59:60")
(check-equal? (ical-event-duration (event "DTSTART:20261117T120000Z\r\nDURATION:PT1H")) "PT1H")
(define raw (bytes-append #"BEGIN:VCALENDAR\r\nBEGIN:VEVENT\r\nSUMMARY:caf" (bytes #xc3) #"\r\n " (bytes #xa9) #"\r\nEND:VEVENT\r\nEND:VCALENDAR"))
(check-equal? (ical-event-title (car (calendar-events (parse-ics raw)))) "café")
(define generic (calendar "X-TEST;X-P=One,Two:raw:value\r\nBEGIN:VEVENT\r\nSUMMARY:first\r\nSUMMARY:second\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nEND:VEVENT\r\nBEGIN:VTODO\r\nSUMMARY:Task\r\nEND:VTODO"))
(check-equal? (length (calendar-events generic)) 2)
(check-equal? (ical-event-title (car (calendar-events generic))) "first")
(check-equal? (ical-event-title (cadr (calendar-events generic))) "Untitled event")
(check-equal? (ical-property-value (car (component-properties generic "x-test"))) "raw:value")
(check-equal? (hash-ref (ical-property-parameters (car (component-properties generic "X-TEST"))) "X-P") '("One" "Two"))
(check-exn exn:fail:ical? (lambda () (parse-ics "BEGIN:VCALENDAR\nEND:VEVENT")))
(check-exn exn:fail:ical? (lambda () (parse-ics "BEGIN:VCALENDAR\nBAD\nEND:VCALENDAR")))
(check-exn exn:fail:ical? (lambda () (parse-ics "BEGIN:VCALENDAR\n")))
(check-exn exn:fail:ical? (lambda () (parse-ics "BEGIN:VCALENDAR\nEND:VCALENDAR" #:max-bytes 10)))
(check-exn exn:fail:ical? (lambda () (parse-ics (bytes #xff))))
(define input (open-input-string "BEGIN:VCALENDAR\nEND:VCALENDAR"))
(check-equal? (ical-component-name (parse-ics input)) "VCALENDAR")
(check-false (port-closed? input))
(check-exn exn:fail:ical? (lambda () (parse-ics (string-append (string-join (make-list 33 "BEGIN:VCALENDAR") "\n") "\n"))))
(check-exn exn:fail:ical? (lambda () (parse-ics "BEGIN:VCALENDAR\nEND:VCALENDAR\nBEGIN:VCALENDAR\nEND:VCALENDAR")))
(check-exn exn:fail:ical? (lambda () (parse-ics "BEGIN:VCALENDAR\nSUMMARY;CN=\"broken:value\nEND:VCALENDAR")))
